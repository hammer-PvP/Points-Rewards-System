<div class="pr-shell pr-ledger-shell">
  <header class="pr-ledger-header">
    <div><span class="pr-eyebrow">Points & Rewards</span><h1>{{actor.name}}</h1>{{#if accountWide}}<p><i class="fa-solid fa-users"></i> Shared account: {{accountLabel}}</p>{{/if}}</div>
    <div class="pr-ledger-balance {{#if isDebt}}debt{{/if}}"><strong>{{balance}}</strong><span>POINTS</span></div>
  </header>
  {{#if isDebt}}<div class="pr-debt-banner"><i class="fa-solid fa-triangle-exclamation"></i><strong>POINT DEBT</strong><span>Earn {{debt}} point(s) to return to zero.</span></div>{{/if}}
  <main class="pr-ledger-body">
    <div class="pr-section-header"><div><h2>Recent Activity</h2><p>Last 10 point movements.</p></div></div>
    {{#if entries.length}}
      <div class="pr-ledger-list">
        {{#each entries}}
          <article><span class="pr-ledger-delta {{#if positive}}positive{{/if}} {{#if negative}}negative{{/if}}">{{signed}}</span><div><strong>{{title}}</strong><small>{{#if description}}{{description}}{{else}}{{type}}{{/if}}</small></div><time>{{when}}</time></article>
        {{/each}}
      </div>
    {{else}}
      <div class="pr-empty-state"><i class="fa-solid fa-receipt"></i><p>No point movements yet.</p></div>
    {{/if}}
  </main>
</div>
