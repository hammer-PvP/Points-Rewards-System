<div class="pr-shell pr-tie-shell">
  <header class="pr-app-header"><div class="pr-brand"><i class="fa-solid fa-scale-balanced"></i><div><h1>Resolve Poll Ties</h1><p>Only questions configured with GM tie-breaking appear here.</p></div></div></header>
  <main class="pr-tie-body">
    {{#each ties}}
      <section class="pr-tie-card">
        <header><div><strong>{{question.title}}</strong><small>{{question.shortLabel}}{{#if hasPoints}} · +{{question.points}} points{{else}} · no point award{{/if}}</small></div><span>{{top}} votes each</span></header>
        <div class="pr-tie-options">
          {{#each tied}}
            <label><input type="radio" name="tie-{{../question.id}}" value="{{valueId}}">{{#if hasImage}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid fa-circle-dot pr-tie-choice-icon" aria-hidden="true"></i>{{/if}}<span><strong>{{name}}</strong><small>{{votes}} votes</small></span></label>
          {{/each}}
        </div>
      </section>
    {{/each}}
  </main>
  <footer class="pr-footer"><span>The GM's tie-break choice is final for this poll.</span><button type="button" class="pr-primary" data-action="finalize"><i class="fa-solid fa-flag-checkered"></i> Confirm Poll Results</button></footer>
</div>
